{
  "name": "opentel-mcp-ui",
  "version": "0.1.1",
  "description": "Zero-infrastructure local dashboard for opentel-mcp -- the silent failures, cost, and thrash loops standard OTel tracing misses",
  "type": "module",
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "opentel-mcp-ui": "./bin/opentel-mcp-ui.js"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "vite build",
    "dev:web": "vite",
    "demo": "node demo/populate.js",
    "verify:tarball": "node scripts/verify-tarball.js",
    "prepublishOnly": "npm run build && npm run verify:tarball"
  },
  "author": "Thirumalaiboobathi B",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thirumalaiboobathi/opentel-mcp.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Thirumalaiboobathi/opentel-mcp/issues"
  },
  "homepage": "https://github.com/Thirumalaiboobathi/opentel-mcp/tree/main/packages/ui#readme",
  "peerDependencies": {
    "opentel-mcp": ">=0.8.0 <1.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "dependencies": {},
  "devDependencies": {
    "opentel-mcp": "^0.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite-plugin-singlefile": "^2.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1"
  }
}
