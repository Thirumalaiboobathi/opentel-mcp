{
  "name": "opentel-mcp-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-infrastructure local dashboard for opentel-mcp's two-axis observation contract",
  "type": "module",
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "opentel-mcp-ui": "./bin/opentel-mcp-ui.js"
  },
  "files": [
    "src",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "vite build",
    "dev:web": "vite",
    "demo": "node demo/populate.js"
  },
  "author": "Thirumalaiboobathi B",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thirumalaiboobathi/opentel-mcp.git",
    "directory": "packages/ui"
  },
  "peerDependencies": {
    "opentel-mcp": ">=0.8.0 <1.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "dependencies": {},
  "devDependencies": {
    "opentel-mcp": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-transformer": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "vite": "^8.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1"
  }
}
