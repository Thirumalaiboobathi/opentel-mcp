{
  "name": "opentel-mcp",
  "version": "0.14.0",
  "description": "One-line OpenTelemetry instrumentation for Model Context Protocol (MCP) servers",
  "type": "module",
  "main": "src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"console.log('opentel-mcp: no build step — plain JS shipped as-is')\"",
    "verify:tarball": "node scripts/verify-tarball.js",
    "bench": "vitest bench --run",
    "prepack": "node scripts/strip-workspaces.js",
    "postpack": "node scripts/restore-workspaces.js",
    "prepublishOnly": "npm run verify:tarball"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opentelemetry",
    "otel",
    "observability",
    "tracing",
    "ai-agents",
    "claude"
  ],
  "author": "Thirumalaiboobathi B",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thirumalaiboobathi/opentel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Thirumalaiboobathi/opentel-mcp/issues"
  },
  "homepage": "https://github.com/Thirumalaiboobathi/opentel-mcp#readme",
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "@modelcontextprotocol/server": ">=2.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "js-yaml": "^4.3.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8",
    "zod": "^4.4.3"
  }
}
