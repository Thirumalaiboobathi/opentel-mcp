{
  "schema": 1,
  "note": "Generated by packages/core/scripts/gen-conformance.mjs from the live core exports. Do not edit by hand.",
  "contractVersion": 2,
  "coreVersion": "0.18.1",
  "instrumentationScope": "opentel-mcp",
  "span": {
    "name": {
      "method": "tools/call",
      "template": "tools/call <tool>",
      "kind": "SERVER"
    },
    "attributes": {
      "methodName": "mcp.method.name",
      "genAiOperationName": "gen_ai.operation.name",
      "genAiToolName": "gen_ai.tool.name",
      "toolArgumentCount": "mcp.tool.argument_count",
      "jsonrpcRequestId": "jsonrpc.request.id",
      "errorType": "error.type"
    },
    "fingerprintAttributes": {
      "FINGERPRINT": "mcp.failure.fingerprint",
      "SIGNATURE": "mcp.failure.signature",
      "CATEGORY": "mcp.failure.category",
      "ORIGIN": "mcp.failure.origin",
      "ERROR_CLASS": "mcp.failure.error_class",
      "CHANNEL": "mcp.failure.channel",
      "VALIDATION_PATHS": "mcp.failure.validation_paths"
    },
    "values": {
      "methodName": "tools/call",
      "operationName": "execute_tool",
      "toolErrorType": "tool_error",
      "outcomes": {
        "success": "success",
        "error": "error",
        "silentFailure": "silent_failure"
      },
      "isErrorOrigin": "tool_error",
      "thrownOrigin": "thrown",
      "isErrorClass": "MCPToolError"
    },
    "deferredInPython": [
      "mcp.failure.validation_paths"
    ]
  },
  "metrics": [
    {
      "name": "mcp.tool.calls",
      "kind": "counter",
      "unit": "",
      "description": "Number of MCP tool calls received, regardless of outcome.",
      "labelKeys": [
        "gen_ai.tool.name",
        "mcp.method.name"
      ],
      "optionalLabelKeys": []
    },
    {
      "name": "mcp.tool.errors",
      "kind": "counter",
      "unit": "",
      "description": "Number of MCP tool calls whose handler threw or rejected (protocol-level failure).",
      "labelKeys": [
        "error.type",
        "gen_ai.tool.name"
      ],
      "optionalLabelKeys": [
        "mcp.failure.category"
      ]
    },
    {
      "name": "mcp.tool.silent_failures",
      "kind": "counter",
      "unit": "",
      "description": "Number of MCP tool calls whose JSON-RPC response succeeded but whose CallToolResult had isError: true.",
      "labelKeys": [
        "gen_ai.tool.name"
      ],
      "optionalLabelKeys": [
        "mcp.failure.category"
      ]
    },
    {
      "name": "mcp.tool.duration",
      "kind": "histogram",
      "unit": "ms",
      "description": "Duration of MCP tool call execution.",
      "labelKeys": [
        "gen_ai.tool.name",
        "mcp.tool.outcome"
      ],
      "optionalLabelKeys": [
        "mcp.failure.category"
      ]
    },
    {
      "name": "mcp.tool.auth_failures",
      "kind": "counter",
      "unit": "",
      "description": "Number of failed MCP tool calls (isError result or thrown) classified as authentication/authorization failures (ADR 031).",
      "labelKeys": [
        "gen_ai.tool.name"
      ],
      "optionalLabelKeys": []
    },
    {
      "name": "mcp.tool.secret_leaks",
      "kind": "counter",
      "unit": "",
      "description": "Number of MCP tool results whose text looked like it contained a credential (ADR 030). A signal, not an error; opt-in.",
      "labelKeys": [
        "gen_ai.tool.name"
      ],
      "optionalLabelKeys": []
    },
    {
      "name": "mcp.tool.integrity_violations",
      "kind": "counter",
      "unit": "",
      "description": "Number of tools whose definition changed since first seen or no longer matches a configured pin (ADR 029). Detection only.",
      "labelKeys": [
        "gen_ai.tool.name"
      ],
      "optionalLabelKeys": []
    }
  ],
  "security": {
    "spanAttributes": [
      "mcp.tool.sensitive",
      "mcp.tool.secret_leak.detected",
      "mcp.tool.secret_leak.types",
      "mcp.tool.secret_leak.count",
      "mcp.tool.secret_leak.scan_truncated"
    ],
    "spanEvents": [
      {
        "name": "mcp.audit.sensitive_call",
        "attributes": [
          "gen_ai.tool.name",
          "mcp.tool.outcome",
          "mcp.tool.duration_ms",
          "mcp.failure.category"
        ]
      },
      {
        "name": "mcp.tool.integrity.changed",
        "attributes": [
          "gen_ai.tool.name",
          "mcp.tool.integrity.old_hash",
          "mcp.tool.integrity.new_hash"
        ]
      },
      {
        "name": "mcp.tool.integrity.pin_mismatch",
        "attributes": [
          "gen_ai.tool.name",
          "mcp.tool.integrity.expected_hash",
          "mcp.tool.integrity.actual_hash",
          "mcp.tool.integrity.severity"
        ]
      },
      {
        "name": "mcp.tool.integrity.added",
        "attributes": [
          "gen_ai.tool.name",
          "mcp.tool.integrity.new_hash"
        ]
      },
      {
        "name": "mcp.tool.integrity.removed",
        "attributes": [
          "gen_ai.tool.name",
          "mcp.tool.integrity.old_hash"
        ]
      }
    ],
    "options": [
      "sensitiveTools",
      "secretLeakDetection",
      "toolIntegrity"
    ],
    "authFailureCategory": "auth",
    "secretTypes": [
      "url_credentials",
      "jwt",
      "http_auth_credential",
      "aws_access_key_id",
      "provider_api_key",
      "secret_assignment"
    ],
    "secretLeak": {
      "defaultMaxScanBytes": 65536,
      "budgetUnit": "utf16-code-units",
      "chunkSize": 4096,
      "chunkOverlap": 256,
      "maxContentItems": 10000,
      "maxDetectedMatches": 1000
    },
    "sensitiveTools": {
      "maxPatterns": 1000,
      "maxPatternLength": 256,
      "maxMatchedNameLength": 1024
    },
    "integrity": {
      "hashPrefix": "sha256:",
      "hashPattern": "^sha256:[0-9a-f]{64}$",
      "hashedFields": [
        "name",
        "title",
        "description",
        "inputSchema",
        "outputSchema",
        "annotations"
      ],
      "severityHigh": "high",
      "maxPins": 1000,
      "maxTrackedTools": 1000
    }
  },
  "jsOnly": {
    "since": "core 0.18.0",
    "spanAttributes": [
      "mcp.tool.freshness.clock_skew_ms"
    ],
    "options": [
      "staleness.clockSkewToleranceMs"
    ]
  },
  "allowlists": {
    "metricSafeAttributes": [
      "gen_ai.tool.name",
      "mcp.method.name",
      "mcp.tool.outcome",
      "error.type",
      "mcp.tool.model"
    ],
    "fingerprintMetricSafeAttributes": [
      "mcp.failure.category",
      "mcp.failure.origin"
    ]
  },
  "failure": {
    "categories": [
      "validation",
      "timeout",
      "network",
      "auth",
      "dependency",
      "serialization",
      "internal",
      "unknown"
    ],
    "channels": [
      "execution",
      "protocol.not_found",
      "protocol.input",
      "protocol.output",
      "protocol.other",
      "unknown"
    ],
    "hashVersion": "v1",
    "fallbackFingerprint": "0000000000000000",
    "fallbackSignature": "unfingerprintable"
  },
  "errorRecording": {
    "modes": [
      "full",
      "normalized",
      "none"
    ],
    "defaultMode": "full",
    "envVar": "OTEL_MCP_ERROR_RECORDING_MODE",
    "maxErrorClassLength": 128,
    "maxNormalizeInputLength": 2048,
    "maxFullMessageLength": 4096,
    "maxFullStackLength": 16384,
    "truncationMarker": " …[truncated by opentel-mcp]"
  }
}
